# Readset configuration. Copy to .env — never commit real values.
# Precedence for the RPC URL: READSET_RPC_URL > ALCHEMY_API_KEY > MONAD_RPC_URL > public default.

# testnet (chain 10143, default) or mainnet (chain 143)
READSET_NETWORK=testnet

# Explicit RPC URL. Must support debug_traceCall for the gate's dependency set.
# READSET_RPC_URL=

# Accepted as a fallback, so an existing Monad setup needs no renaming.
# MONAD_RPC_URL=
# MONAD_TESTNET_RPC_URL=

# Forensics (/tx/[hash]) needs ARCHIVE state plus tracing. Without this, Readset tries the
# public archive endpoints in order and fails over between them. See docs/kill-tests/K1.md for
# the measured history window of each public endpoint.
# READSET_ARCHIVE_RPC=https://rpc-mainnet.monadinfra.com

# Optional Alchemy key; builds https://monad-<network>.g.alchemy.com/v2/<key>.
# Note: Alchemy's Monad endpoint has debug_* disabled, so it cannot serve the forensics path.
# ALCHEMY_API_KEY=

# Only needed to SIGN. 0x + 64 hex. Use a throwaway key. Never logged, never returned by an API.
# READSET_PRIVATE_KEY=

# Where receipts, policy and breaker state live. Defaults to <cwd>/.readset.
# READSET_HOME=

# Run the test suite without touching the network (recorded fixtures only).
# READSET_OFFLINE=1

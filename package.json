{
  "name": "readset",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "npm run dev -w @readset/web",
    "build": "npm run build:core && npm run build -w @readset/web",
    "build:core": "npm run build -w @readset/core"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "viem": "^2.57.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "@rolldown/binding-win32-x64-msvc": "1.2.12"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.2.12"
  }
}